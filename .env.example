# Every variable is namespaced with OPS_ so that an ambient ANTHROPIC_API_KEY or
# AWS_REGION exported for some other tool cannot silently take over the agent's
# model configuration.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
OPS_DATABASE_URL=postgresql+psycopg://opsagent:opsagent@localhost:5437/opsagent

# ---------------------------------------------------------------------------
# Model provider
#
# bedrock   -> Amazon Bedrock via Strands BedrockModel (production / AgentCore)
# anthropic -> any Anthropic-compatible endpoint via Strands AnthropicModel
#              (local development, when Bedrock is not provisioned yet)
# ---------------------------------------------------------------------------
OPS_MODEL_PROVIDER=bedrock

# --- Bedrock ---
# AWS credentials come from the standard chain (env vars, ~/.aws, instance role).
# OPS_AWS_REGION falls back to AWS_REGION / AWS_DEFAULT_REGION if unset.
OPS_AWS_REGION=us-west-2
OPS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Anthropic-compatible endpoint ---
OPS_COMPAT_API_KEY=
OPS_COMPAT_BASE_URL=
OPS_COMPAT_MODEL_ID=claude-sonnet-4-5-20250929

# ---------------------------------------------------------------------------
# Agent runtime
# ---------------------------------------------------------------------------
OPS_MODEL_MAX_TOKENS=4096

# Where a paused run's state is kept so it can be resumed after an approval.
OPS_AGENT_SESSION_DIR=.sessions
# Set to an S3 bucket to keep paused sessions in AWS instead of on local disk.
OPS_AGENT_SESSION_S3_BUCKET=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
OPS_API_HOST=0.0.0.0
OPS_API_PORT=8010
OPS_CORS_ORIGINS=http://localhost:3010,http://localhost:3000
OPS_LOG_LEVEL=INFO
